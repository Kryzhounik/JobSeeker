{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/agent_filter_result.schema.json",
  "title": "Agent relevance filter result",
  "type": "object",
  "additionalProperties": false,
  "required": ["nonrelevant_jobs"],
  "properties": {
    "nonrelevant_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "job_id"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "job_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
