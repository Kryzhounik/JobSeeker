<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.seeker.guifx.MainController"
            prefWidth="720.0"
            prefHeight="420.0">
    <center>
        <VBox alignment="CENTER" spacing="8.0" styleClass="launch-view">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <Label text="Seeker Jobs" styleClass="app-title" />
            <Label fx:id="launchStatus" styleClass="launch-status" />
        </VBox>
    </center>
</BorderPane>
