<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import com.seeker.guifx.WindowStatusBar?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.seeker.guifx.MainController"
            prefWidth="1440.0"
            prefHeight="900.0"
            styleClass="root">
    <top>
        <VBox styleClass="toolbar">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <padding><Insets top="7.0" right="10.0" bottom="5.0" left="10.0" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="toolbar-button-group">
                    <Button fx:id="batchButton" text="Batch" styleClass="collect-button, batch-button" />
                    <Button fx:id="collectButton" text="Collect" styleClass="collect-button" />
                    <Button fx:id="recommendationsButton" text="Recommendations" styleClass="collect-button" />
                </HBox>
                <Button fx:id="linkedinCheckButton" text="Check LinkedIn" />
                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="toolbar-button-group">
                    <Button fx:id="refilterButton" text="Refilter" />
                    <Button fx:id="refilterDetailButton" text="Refilter detail" />
                </HBox>
                <Button fx:id="runsButton" text="Runs" />
                <Button fx:id="companiesButton" text="Companies" />
                <Button fx:id="applicationsButton" text="Applications" />
                <Button fx:id="collectedButton" text="Collected" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="backgroundProcessDocks" alignment="CENTER_RIGHT" spacing="6.0" />
                <Button fx:id="configButton" text="⚙" accessibleText="Config" />
            </HBox>
            <fx:include fx:id="jobFilters" source="job-filters.fxml" />
        </VBox>
    </top>
    <center>
        <StackPane fx:id="backgroundProcessLayer">
        <SplitPane fx:id="mainSplit" dividerPositions="0.48" orientation="VERTICAL" styleClass="main-split">
            <items>
                <TableView fx:id="jobsTable">
                    <columns>
                        <TableColumn fx:id="scoreColumn" id="scoreColumn" text="Score" prefWidth="62.0" />
                        <TableColumn fx:id="fitColumn" id="fitColumn" text="Fit" prefWidth="52.0" />
                        <TableColumn fx:id="interestColumn" id="interestColumn" text="Interest" prefWidth="76.0" />
                        <TableColumn fx:id="statusColumn" id="statusColumn" text="Status" prefWidth="82.0" />
                        <TableColumn fx:id="remoteColumn" id="remoteColumn" text="Remote" prefWidth="90.0" />
                        <TableColumn fx:id="relocationColumn" id="relocationColumn" text="Reloc" prefWidth="68.0" />
                        <TableColumn fx:id="locationColumn" id="locationColumn" text="Location" prefWidth="145.0" />
                        <TableColumn fx:id="companyColumn" id="companyColumn" text="Company" prefWidth="155.0" />
                        <TableColumn fx:id="titleColumn" id="titleColumn" text="Title" prefWidth="280.0" />
                        <TableColumn fx:id="roleColumn" id="roleColumn" text="Role" prefWidth="105.0" />
                        <TableColumn fx:id="seniorityColumn" id="seniorityColumn" text="Seniority" prefWidth="90.0" />
                        <TableColumn fx:id="languageColumn" id="languageColumn" text="Language" prefWidth="125.0" />
                        <TableColumn fx:id="salaryColumn" id="salaryColumn" text="Salary" prefWidth="145.0" />
                        <TableColumn fx:id="addedColumn" id="addedColumn" text="Added" prefWidth="94.0" />
                        <TableColumn fx:id="reasonCodeColumn" id="reasonCodeColumn" text="Reason code" prefWidth="115.0" />
                        <TableColumn fx:id="reasonColumn" id="reasonColumn" text="Reason" prefWidth="300.0" />
                    </columns>
                </TableView>
                <fx:include fx:id="jobDetail" source="job-detail.fxml" />
            </items>
        </SplitPane>
        </StackPane>
    </center>
    <bottom>
        <WindowStatusBar>
            <left><Button fx:id="blackTitlesButton" text="Black titles" /></left>
            <status><Label fx:id="statusLabel" text="Starting..." /></status>
        </WindowStatusBar>
    </bottom>
</BorderPane>
